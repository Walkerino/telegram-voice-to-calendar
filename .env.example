TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY=
# Required for /connect_icloud command (encryption of personal iCloud app password)
# Optional: direct iCloud CalDAV sync (no .ics file when sync succeeds)
ICLOUD_APPLE_ID=""
ICLOUD_APP_SPECIFIC_PASSWORD=""
ICLOUD_CALDAV_BASE_URL=https://caldav.icloud.com
ICLOUD_CALENDAR_NAME="Calendar"
# Free default mode (no paid APIs)
TRANSCRIBER=mock
EVENT_PARSER=rules
# Optional local LLM adapter (stage 2)
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional external LLM provider (OpenRouter/Groq/custom OpenAI-compatible)
# Keep disabled by default; project will use rule-based fallback.
LLM_ENABLED=0
LLM_PROVIDER=openrouter
LLM_API_KEY=
# For provider=openrouter, default endpoint if empty: https://openrouter.ai/api/v1
# For provider=groq, default endpoint if empty: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Set a provider model id. For OpenRouter free tier use a model with :free suffix.
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2
# OpenRouter optional headers
LLM_APP_URL=http://localhost:3000
LLM_APP_NAME=telegram-voice-assistant
# Public HTTPS URL for Telegram Mini App (if empty, falls back to LLM_APP_URL)
MINI_APP_URL=
# Telegram anti-flood limit
TELEGRAM_RATE_LIMIT_PER_MINUTE=25
# Optional only for local open-source whisper mode (TRANSCRIBER=whisper)
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=ru
WHISPER_THREADS=4
# Optional quality tuning for whisper.cpp
# Domain prompt helps with calendar/time vocabulary.
WHISPER_INITIAL_PROMPT=
# Decoder search params (bigger = potentially better quality, slower).
WHISPER_BEST_OF=8
WHISPER_BEAM_SIZE=8
# 1/true/yes/on enables the option.
WHISPER_NO_TIMESTAMPS=1
WHISPER_SUPPRESS_NON_SPEECH=1
# Optional ffmpeg filter before STT, e.g. highpass=f=80,lowpass=f=7600
WHISPER_AUDIO_FILTER=
# Optional Silero VAD model path enables VAD in whisper.cpp.
WHISPER_VAD_MODEL_PATH=
WHISPER_VAD_THRESHOLD=0.5
# Optional for mock transcriber text
MOCK_TRANSCRIPT_TEXT="Встреча завтра в 18:30 на час"
# Optional faster-whisper mode (TRANSCRIBER=faster-whisper)
FASTER_WHISPER_PYTHON_BIN=python3
FASTER_WHISPER_SCRIPT_PATH=src/lib/transcriber/scripts/faster_whisper_transcribe.py
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_LANGUAGE=ru
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_BEST_OF=5
FASTER_WHISPER_VAD_FILTER=1
FASTER_WHISPER_TIMEOUT_MS=300000
