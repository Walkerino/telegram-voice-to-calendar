TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY=
# Required for /connect_icloud command (encryption of personal iCloud app password)
# Optional: direct iCloud CalDAV sync (no .ics file when sync succeeds)
ICLOUD_APPLE_ID=""
ICLOUD_APP_SPECIFIC_PASSWORD=""
ICLOUD_CALDAV_BASE_URL=https://caldav.icloud.com
ICLOUD_CALENDAR_NAME="Calendar"
# Free default mode (no paid APIs)
TRANSCRIBER=mock
EVENT_PARSER=rules
# Optional only for local open-source whisper mode (TRANSCRIBER=whisper)
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
# Optional quality tuning for whisper.cpp
# Domain prompt helps with calendar/time vocabulary.
WHISPER_INITIAL_PROMPT=
# Decoder search params (bigger = potentially better quality, slower).
WHISPER_BEST_OF=5
WHISPER_BEAM_SIZE=5
# 1/true/yes/on enables the option.
WHISPER_NO_TIMESTAMPS=1
WHISPER_SUPPRESS_NON_SPEECH=1
# Optional ffmpeg filter before STT, e.g. highpass=f=80,lowpass=f=7600
WHISPER_AUDIO_FILTER=
# Optional Silero VAD model path enables VAD in whisper.cpp.
WHISPER_VAD_MODEL_PATH=
WHISPER_VAD_THRESHOLD=0.5
# Optional for mock transcriber text
MOCK_TRANSCRIPT_TEXT="Встреча завтра в 18:30 на час"
