generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PipelineStatus {
  received
  transcribed
  parsed
  awaiting_confirmation
  created
  cancelled
  stored
  scheduled
  done
  archived
  failed
}

enum UserState {
  idle
  awaiting_edit
}

enum InboxItemType {
  event
  task
  reminder
  note
  journal
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStatus {
  open
  in_progress
  done
  archived
}

enum ReminderStatus {
  pending
  sent
  cancelled
  failed
}

enum JobKind {
  reminder
  digest
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum CalendarEventStatus {
  drafted
  created
  synced
  failed
}

enum CalendarProvider {
  icloud
}

enum ConnectionStatus {
  disconnected
  connected
  invalid
}

model User {
  id                    String               @id @default(cuid())
  telegramUserId        String               @unique
  telegramUsername      String?
  firstName             String?
  lastName              String?
  timezone              String               @default("Europe/Warsaw")
  defaultReminderMinutes Int?                @default(30)
  languageCode          String?              @default("ru")
  state                 UserState            @default(idle)
  currentDraftMessageId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  messages              Message[]
  events                Event[]
  tasks                 Task[]
  reminders             Reminder[]
  jobs                  Job[]
  calendarEvents        CalendarEvent[]
  calendarConnections   CalendarConnection[]
}

model Message {
  id                String         @id @default(cuid())
  userId            String
  telegramChatId    String
  telegramMessageId Int
  telegramUpdateId  Int?
  voiceFileId       String?
  transcript        String?
  rawText           String?
  itemType          InboxItemType  @default(event)
  draftJson         Json?
  parsedJson        Json?
  status            PipelineStatus @default(received)
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event?
  task              Task?
  reminder          Reminder?
  calendarEvent     CalendarEvent?

  @@unique([telegramChatId, telegramMessageId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, itemType, createdAt(sort: Desc)])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  messageId   String   @unique
  uid         String   @unique
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  timezone    String
  reminders   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  inboxItemId String?      @unique
  title       String
  notes       String?
  dueAt       DateTime?
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(open)
  tags        Json?
  project     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxItem   Message?     @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
}

model Reminder {
  id          String         @id @default(cuid())
  userId      String
  inboxItemId String?        @unique
  remindAt    DateTime
  message     String
  status      ReminderStatus @default(pending)
  payload     Json?
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxItem   Message?       @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
}

model CalendarEvent {
  id              String              @id @default(cuid())
  userId          String
  inboxItemId     String?             @unique
  uid             String              @unique
  title           String
  startAt         DateTime
  endAt           DateTime
  location        String?
  status          CalendarEventStatus @default(created)
  createdInIcloud Boolean             @default(false)
  providerMeta    Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxItem       Message?            @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
}

model Job {
  id         String    @id @default(cuid())
  userId     String
  kind       JobKind
  runAt      DateTime
  dedupeKey  String?   @unique
  payload    Json
  status     JobStatus @default(pending)
  attempts   Int       @default(0)
  lastError  String?
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([userId, kind, runAt])
}

model CalendarConnection {
  id                    String           @id @default(cuid())
  userId                String
  provider              CalendarProvider
  appleId               String?
  encryptedAppPassword  String?
  encryptedSecret       String?
  calendarUrl           String?
  isActive              Boolean          @default(true)
  status                ConnectionStatus @default(disconnected)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}
